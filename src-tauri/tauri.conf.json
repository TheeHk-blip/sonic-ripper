{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonicRipper",
  "version": "1.0.3",
  "identifier": "com.sonicripper.com",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sonic Ripper",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "decorations": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' https://sonic-worker.muguropeter15.workers.dev/ https://www.youtube.com https://www.youtube-nocookie.com https://*.youtube.com; media-src 'self' blob: https://*.googlevideo.com; img-src 'self' https://*.ytimg.com https://*.scdn.co https://*.spotifycdn.com data: blob:; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* https://*.youtube.com https://*.googlevideo.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sonic-yt-dlp", "binaries/sonic-ffmpeg", "binaries/sonic-deno"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMzlBQ0NFODRCRjFBMjQKUldRa0dyK0V6cXc1YTVRWGpUL2NrRGN3TFZnVTAxdDVuZUxPTTJSdVE5VEdlYXBLVjJ2UWY0VmQK",
      "endpoints": [
        "https://github.com/TheeHk-blip/sonic-ripper/releases/latest/download/latest.json"
      ]
    }
  }
}
